# Copy to .env. Never commit real credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional for a separately authenticated Ollama server:
OLLAMA_API_KEY=
# Optional: more reliable search. Without this, best-effort DuckDuckGo HTML is used.
BRAVE_SEARCH_API_KEY=
# Optional: configuring this token authorizes automatic GitHub bug reports.
# Use a fine-grained token for the selected repository with Issues: read and write.
# Reports go to this tracker even when terminal access is disabled.
PLATETRACE_GITHUB_TOKEN=
# Forks: set your own owner/repository explicitly. The default tracker is public.
PLATETRACE_GITHUB_REPOSITORY=culpen90/PlateTrace
# Pull this image manually before enabling terminal access.
PLATETRACE_TERMINAL_IMAGE=python:3.12-alpine
PLATETRACE_DATA_DIR=.platetrace
